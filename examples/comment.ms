/* This is a comment.
   Below is the code to find factorial. */


"Input number : " kanikuga; 
num = akam_vangikuga;
factorial = 1;

0 um num um thullyamalla enkil avarthikuga {  // this is a loop
    factorial = factorial * num; 
    num = num - 1;
}

"Factoral is : " + factorial + "\n" kanikuga;
