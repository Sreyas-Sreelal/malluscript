test_plugin p ennu ulppeduthuka;

malayalam_multiply(x) {
    "Interpreted function called with: " ezhuthuka;
    x ezhuthuka;
    "\n" ezhuthuka;
    x * 2 kodukuka;
}

"Calling malayalam_multiply from native plugin: \n" ezhuthuka;
result = p.invoke_malluscript<"malayalam_multiply", 50>;
"Result from native plugin: " ezhuthuka;
result ezhuthuka;
"\n" ezhuthuka;

